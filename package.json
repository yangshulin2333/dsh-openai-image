{
  "name": "@yangshulin2333/dsh-openai-image",
  "version": "0.2.3",
  "description": "OpenAI Images 2.6 (gpt-image-2.6 flare/sunburst) tools for DeepSeek Harness, with Roblox Open Cloud asset upload.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "pack:dry": "npm pack --dry-run"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "openai",
    "gpt-image",
    "gpt-image-2.6",
    "images-2.6",
    "roblox",
    "open-cloud",
    "decal",
    "game-assets"
  ],
  "license": "MIT",
  "author": "yangshulin2333",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangshulin2333/dsh-openai-image.git"
  },
  "homepage": "https://github.com/yangshulin2333/dsh-openai-image#readme",
  "bugs": {
    "url": "https://github.com/yangshulin2333/dsh-openai-image/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^0.1.0 || ^0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
